# Chave da API Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# Modelo Gemini (opcional)
GEMINI_MODEL=gemini-3.6-flash

# Tag de afiliado da Amazon (ex.: minhaloja-20)
AFFILIATE_TAG=seu-tag-20

# Amazon Creators API (opcional). Conta nova costuma estar bloqueada até
# a Amazon aprovar e, para catálogo, exigir vendas qualificadas.
# Associates Central → Tools → Creators API
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# Versão da credencial. Brasil/NA costuma ser 3.1
AMAZON_CREDENTIAL_VERSION=3.1

# Cole links amzn.to ou /dp/ separados por vírgula (tem prioridade sobre a busca)
# AFFILIATE_LINKS=https://amzn.to/xxxx,https://amzn.to/yyyy

# Quantidade máxima de ofertas por termo (opcional)
# MAX_OFERTAS=3

# Só use em desenvolvimento. Sem isso o gerador NÃO inventa produtos.
# ALLOW_SIMULATED=1
